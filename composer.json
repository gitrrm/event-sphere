{
    "name": "gitrrm/event-sphere",
    "description": "Enterprise WordPress Event Management Plugin",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EventSphere\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Rashmi Ranjan Muduli"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.4",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
